# Copy to .env.local and fill in. .env.local is gitignored.
#
# NOTE: everything here is NEXT_PUBLIC_ because the treasurer's write path
# builds and submits transactions in the browser (see AGENTS/architecture
# notes). None of these are secrets -- a contract ID and a public RPC endpoint
# are both readable from the chain anyway. Never put a Stellar secret key in
# this file; signing happens exclusively inside the Freighter extension.

# Which Stellar network to talk to: TESTNET | PUBLIC
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET

# Soroban RPC endpoint.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# The deployed TreasuryChain contract (starts with "C", 56 chars).
# Leave blank until Step 6 deploys it -- the app renders a "not deployed yet"
# state instead of crashing.
NEXT_PUBLIC_CONTRACT_ID=

# ISO 4217 code used to render amounts. Display-only: the chain stores plain
# integers and has no concept of currency, so changing this never migrates or
# reinterprets existing records.
NEXT_PUBLIC_CURRENCY=PHP
